# OS / editor files
.DS_Store
Thumbs.db
*.swp
*.tmp
~$*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.ipynb_checkpoints/

# R
.Rhistory
.RData
.Rproj.user/

# Raw data: keep local/source copies out of GitHub
data/raw/*
!data/raw/.gitkeep

# Generated outputs
outputs/*
!outputs/.gitkeep

# Common large/binary analysis files
*.zip
*.7z
*.tar
*.gz
*.rar
*.h5
*.hdf5
*.parquet
*.feather

# Logs
*.log

# Legacy local research workspace. Only the normalized processed layer is
# eligible for ordinary tracking; primary PDFs and intermediate extractions
# stay local unless deliberately reviewed and force-added.
data/*
!data/raw/
!data/processed/
data/raw/*
!data/raw/.gitkeep

# Large generated or downloaded workspace trees
download_papers/
tmp/
ml/
.claude/
scripts/node_modules/
figures/*
!figures/.gitkeep
!figures/*.md

# Loose root-level source documents from the pre-repository workspace
/*.pdf
/*.png
/*.docx
/*.pptx
